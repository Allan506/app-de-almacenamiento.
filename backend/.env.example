# --- Servidor ---
APP_NAME=Nube
APP_URL=http://localhost:12000
# SECRET_KEY=cambia-esta-clave-en-produccion
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/nube

# --- Acceso OTP ---
# auto | email | telegram | console
OTP_CHANNEL=auto
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_PER_HOUR=10
# true en desarrollo muestra el codigo en la interfaz
# OTP_DEV_MODE=true

# --- Correo (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=clave-de-aplicacion
# SMTP_FROM=Nube <tu-cuenta@gmail.com>

# --- Telegram (OTP y almacenamiento) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_CHUNK_BYTES=19922944

# --- Almacenamiento ---
# local | telegram
STORAGE_BACKEND=local
# 0 = sin limite
DEFAULT_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=0

# --- CORS ---
CORS_ORIGINS=*
